{
  "name": "@ftb/service",
  "version": "0.1.0",
  "private": true,
  "description": "The Registry Service: a Cloudflare Worker (Hono + D1) that holds the canonical registry, enforces the covenant, and writes the Drive archive.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run --project service",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "import:sql": "tsx scripts/import.ts ../data/registry > .import.sql",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=.import.sql"
  },
  "dependencies": {
    "@ftb/core": "0.1.0",
    "hono": "4.13.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260907.1",
    "tsx": "4.23.13",
    "wrangler": "4.129.0"
  }
}
