# Cloudflare Pages headers. The shell and the service worker must never be served stale — a cached
# index.html would point at hashed assets that no longer exist after a redeploy. Hashed assets are
# immutable by construction.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
