# Release signing for Free the Brain — copy to android/keystore.properties and fill in.
# The real file is gitignored. NEVER commit it, NEVER commit the keystore it points at.
# storeFile is resolved relative to android/ (rootProject); an absolute path works too.
# Generate the keystore with the exact keytool command in docs/android-release.md, step 4.
storeFile=../../../secrets/free-the-brain-upload.jks
storePassword=CHANGE-ME
keyAlias=upload
keyPassword=CHANGE-ME
